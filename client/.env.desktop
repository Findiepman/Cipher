# What `vite build --mode desktop` reads: the build the Tauri shell bundles.
#
# The page is served from the app's own origin (http://tauri.localhost on
# Windows, tauri://localhost elsewhere), so the API is a full URL and the
# session rides in an Authorization header rather than in cookies, which the
# WebView would never attach across origins. VITE_PLATFORM picks the desktop
# adapter in src/lib/platform.
#
# A variable set in the environment wins over this file, so a staging build
# is `VITE_API_URL=https://staging.example.test npm run build:desktop`. The
# desktop CSP in desktop/src-tauri/tauri.conf.json names the production host
# and has to be widened for that build to connect.
VITE_API_URL=https://cipher.findiepman.dev
VITE_AUTH_MODE=bearer
VITE_BACKEND=http
VITE_PLATFORM=desktop
