# What `vite --mode desktop-dev` reads: the dev server the Tauri shell opens
# from `npm run dev` in desktop/. Same shape as .env.desktop, pointed at the
# local API, so the shell in development behaves like the shipped one (bearer
# auth, the desktop adapter) rather than like a browser tab.
VITE_API_URL=http://localhost:3000
VITE_AUTH_MODE=bearer
VITE_BACKEND=http
VITE_PLATFORM=desktop
