# Base URL of the Fastify API in server/.
#
# Development is genuinely cross-origin (Vite on :5173, Fastify on :3000), so
# this points at the API's own port.
#
# LEAVE IT BLANK (VITE_API_URL=) for the production build. Blank means
# same-origin: Caddy serves this build and proxies /auth, /socket.io and the
# rest to Fastify on one hostname, so requests go out as relative paths. That
# is what keeps the auth cookies first-party and removes CORS entirely.
VITE_API_URL=http://localhost:3000

# "cookie" for the web build (httpOnly refresh cookie + CSRF header),
# "bearer" for the desktop app, whose page origin is not the API's, so the
# WebView would never attach the API's cookies.
VITE_AUTH_MODE=cookie

# "http" talks to server/ (the default). "mock" runs the chat UI off local
# fixtures with no server, in which case nothing signs in.
VITE_BACKEND=http

# "web" (the default) or "desktop". Picks the platform adapter in
# src/lib/platform. Not set here: the desktop build reads .env.desktop and
# .env.desktop-dev, which set all four of these together.
# VITE_PLATFORM=web
