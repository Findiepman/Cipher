# Production secrets and settings for the mini PC.
#
#   cp .env.example .env      # then fill it in; .env is gitignored
#
# The name matters: compose reads deploy/.env automatically, both for the
# ${...} substitutions in docker-compose.prod.yml and as the server's
# environment. Any other name needs --env-file on every command.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# The public URL, and the only one. It is the origin the client is served
# from, the CORS allowlist, and the base of every link in every email, so a
# wrong value here shows up as verification links nobody can open.
# No trailing slash.
APP_URL=https://cipher.findiepman.dev

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres never leaves the compose network - no port is published - but this
# is still the credential for all of your message history. Generate it:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# DATABASE_URL is assembled from POSTGRES_PASSWORD in docker-compose.prod.yml.
# Do not set it here; the compose value would win and the two would drift.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Signs access tokens. Changing it signs everyone out, which is the intended
# way to revoke every session at once.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------

# The server refuses to boot in production unless this is true.
COOKIE_SECURE=true

# Leave blank. Blank means host-only, which is what you want on a single
# hostname: setting it to a parent domain would send the auth cookies to every
# subdomain, including anything else you ever host there.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Mail (Resend)
# ---------------------------------------------------------------------------

# Not optional. Verification is required before login, so if mail does not
# send, nobody can create an account - including you. The server refuses to
# boot in production with any transport other than smtp.
#
# SMTP_USER is the literal string "resend"; the password is the API key.
# See ../DEPLOY.md for the Cloudflare DNS records that must exist first.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=

# Must be on the domain you verified with Resend, or every send is rejected.
MAIL_FROM="Cipher <no-reply@findiepman.dev>"

# ---------------------------------------------------------------------------
# Voice calls (Cloudflare Realtime TURN)
# ---------------------------------------------------------------------------

# Optional, but without them calls are STUN only: two browsers that cannot
# reach each other directly (most home routers, every office network) will
# fail to connect. The tunnel carries no UDP, so a TURN server on this box is
# not an option; Cloudflare's is, and it mints a short-lived credential per
# call from this key. The key itself never leaves the server. Both or neither:
# the server refuses to boot with only one set. See DEPLOY.md, "Voice calls".
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# ---------------------------------------------------------------------------
# Ingress
# ---------------------------------------------------------------------------

# From the Cloudflare Zero Trust dashboard, on the tunnel you created. It is a
# long opaque string and it is a credential - anyone holding it can publish a
# tunnel as you. Point the tunnel's public hostname at http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Account lockout
# ---------------------------------------------------------------------------

MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
