{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cipher",
  "version": "1.0.0",
  "identifier": "dev.findiepman.cipher",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run --prefix .. dev:desktop-client",
    "beforeBuildCommand": "npm run --prefix .. build:desktop-client"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://cipher.findiepman.dev wss://cipher.findiepman.dev",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Cipher",
    "longDescription": "Private messaging. The Cipher desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRjkzODcyQUZBMUQ4RDgKUldUWTJLR3Zjamo1LzgvOE04dWhoZUJCRkJZUzQrRTdjeWp6dnU5RW9nUjdMdGdxck1IWkNRSWkK",
      "endpoints": [
        "https://github.com/Findiepman/Cipher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
