{
  "name": "@cipher/crypto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only place in the repo that calls libsodium. Consumed by client/ for all encryption; server/ may use the format helpers, never anything that decrypts.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  }
}
