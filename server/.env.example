NODE_ENV=development
PORT=3000

# Public URL of the client app. Used to build links in emails.
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://messenger:messenger@localhost:5432/messenger?schema=public

# Tests truncate every table, so they run against a separate database.
TEST_DATABASE_URL=postgresql://messenger:messenger@localhost:5432/messenger_test?schema=public

# Signing secret for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value-at-least-32-chars

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Cookie settings. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Mail transport:
#   file    - write each message to .mail/ (required by `npm run smoke`)
#   console - print each message to the server log
#   smtp    - really send it (Mailpit, or a real provider)
# Only smtp is permitted when NODE_ENV=production, because verification is
# required before login: if mail silently does not send, nobody can create an
# account, including you.
MAIL_TRANSPORT=file

# Local Mailpit. Port 1025 is the one port that skips TLS - anything else is
# treated as a real relay and TLS is required, not merely attempted.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Messenger <no-reply@messenger.local>"

# Production (Resend). SMTP_USER is the literal string "resend"; the password
# is the API key. See ../DEPLOY.md for the Cloudflare DNS records that have to
# exist before any of this delivers.
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM="Cipher <no-reply@yourdomain.com>"
#
# Check it before relying on it:
#   npm run mail:test -- you@yourdomain.com
#   npm run mail:test -- --preview      # renders both emails to .mail/, sends nothing

# Account lockout
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# Voice calls. Optional: leave both blank for STUN only, which is enough for
# two browsers on the same machine or LAN. To test relaying through Cloudflare
# TURN in development, create a TURN key in the Cloudflare dashboard under
# Realtime and paste both halves here. Both or neither.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
