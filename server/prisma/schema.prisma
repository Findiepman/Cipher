// Accounts & auth (../backend-plan.md) plus DM messaging and the friend graph
// (../messaging-plan.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum EmailTokenPurpose {
  VERIFY
  RESET
  EMAIL_CHANGE
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  /// Always stored lowercased; normalize on the way in, never compare raw input.
  email    String @unique
  username String @unique

  /// argon2id of the *authHash* the client sends - which is itself argon2id of
  /// the password, derived on the device. The server never receives, and can
  /// therefore never leak, the password itself. Hashed again here so a database
  /// dump does not hand out working login credentials.
  authVerifier String

  /// SHA-256 of the account recovery code. The code itself exists only on paper
  /// wherever the user wrote it down; losing it costs the message history.
  recoveryCodeHash String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions    Session[]
  emailTokens EmailToken[]
  devices     Device[]

  auditActions AuditLog[] @relation("AuditActor")
  auditTargets AuditLog[] @relation("AuditTarget")

  friendshipsAsA Friendship[] @relation("FriendshipUserA")
  friendshipsAsB Friendship[] @relation("FriendshipUserB")

  conversations ConversationParticipant[]
  messages      Message[]
  envelopes     MessageEnvelope[]

  @@index([status])
  @@index([createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

/// One row per *pair*, not per direction.
///
/// userAId and userBId are stored in canonical (sorted) order behind a unique
/// index, so A->B and B->A cannot both exist as separate pending requests -
/// which is the bug this shape exists to make unrepresentable. Who asked is
/// recorded separately, because that is all "incoming" vs "outgoing" means.
model Friendship {
  id String @id @default(uuid()) @db.Uuid

  userAId String @db.Uuid
  userA   User   @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String @db.Uuid
  userB   User   @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  requestedById String @db.Uuid

  /// Set only while status is BLOCKED. A block belongs to whoever applied it -
  /// without this the other party could lift their own block.
  blockedById String? @db.Uuid

  status FriendshipStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

/// Generic on purpose, but v1 only ever creates two-participant rows.
/// `dmKey` is what stops opening a DM twice from creating two conversations.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  /// "<smaller uuid>:<larger uuid>" for a DM; null for a future group.
  dmKey String? @unique

  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The client's own read position. The server can order messages but cannot
  /// read them, so "unread" is a count of ids, never of content.
  lastReadMessageId String? @db.Uuid

  joinedAt DateTime @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

/// The header of a message. The body is not here - see MessageEnvelope.
model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// The sender's own id, echoed back. Unique per conversation, which is what
  /// makes a send retried across a flaky reconnect one message and not two.
  clientId String

  sentAt DateTime @default(now())

  /// Monotonic, so a cursor is "everything after this row" rather than a
  /// timestamp comparison that ties on same-millisecond sends.
  seq BigInt @default(autoincrement())

  envelopes MessageEnvelope[]

  @@unique([conversationId, clientId])
  @@index([conversationId, seq])
}

/// One sealed copy of a message, addressed to one participant - including the
/// author, who otherwise could not read their own history on a new device
/// (crypto_box seals to exactly one recipient).
///
/// `ciphertext` is opaque to this server, permanently. Nothing here may ever
/// read, index, search or log it.
model MessageEnvelope {
  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  recipientUserId String @db.Uuid
  recipient       User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  ciphertext String

  @@id([messageId, recipientUserId])
  @@index([recipientUserId])
}

/// One row per refresh token. Rotation creates a new row and points the old
/// one at it via replacedById; every row from one login shares a familyId so
/// that replaying a spent token can revoke the whole family at once.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. The raw token only ever lives in the cookie.
  refreshTokenHash String @unique
  familyId         String @db.Uuid

  deviceLabel String?
  ip          String?
  userAgent   String?

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Single-use, hashed, expiring tokens delivered by email.
model EmailToken {
  id     String @db.Uuid @id @default(uuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   EmailTokenPurpose
  tokenHash String            @unique

  /// Only set for EMAIL_CHANGE: the address being moved to.
  newEmail String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// A device's key material. The public key is the registry other users look up
/// to send this account a message; the two wrapped blobs are the same private
/// key sealed under two different secrets, and the server can open neither.
///
/// Storing them here is what lets someone sign in on a new machine: the blob
/// comes down with the login response and is unwrapped locally.
model Device {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human-readable, for the user's own device list. e.g. "Firefox on Windows".
  label String

  /// base64 X25519 public key. The only field here that is meant to be shared.
  publicKey String

  /// blob_A - the private key wrapped under the account password.
  wrappedPrivateKey String

  /// blob_B - the same private key wrapped under the recovery code.
  wrappedPrivateKeyRecovery String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  @@index([userId])
  @@index([publicKey])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for unauthenticated actions (a failed login, a reset request).
  actorUserId String? @db.Uuid
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  targetUserId String? @db.Uuid
  target       User?   @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action String
  ip     String?
  meta   Json?

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}
