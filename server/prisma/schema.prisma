// Accounts & auth schema. See ../backend-plan.md.
// Message/channel tables are deliberately absent - they belong to the
// messaging work, not the account work.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum EmailTokenPurpose {
  VERIFY
  RESET
  EMAIL_CHANGE
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  /// Always stored lowercased; normalize on the way in, never compare raw input.
  email    String @unique
  username String @unique

  /// argon2id of the *authHash* the client sends - which is itself argon2id of
  /// the password, derived on the device. The server never receives, and can
  /// therefore never leak, the password itself. Hashed again here so a database
  /// dump does not hand out working login credentials.
  authVerifier String

  /// SHA-256 of the account recovery code. The code itself exists only on paper
  /// wherever the user wrote it down; losing it costs the message history.
  recoveryCodeHash String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions    Session[]
  emailTokens EmailToken[]
  devices     Device[]

  auditActions AuditLog[] @relation("AuditActor")
  auditTargets AuditLog[] @relation("AuditTarget")

  @@index([status])
  @@index([createdAt])
}

/// One row per refresh token. Rotation creates a new row and points the old
/// one at it via replacedById; every row from one login shares a familyId so
/// that replaying a spent token can revoke the whole family at once.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. The raw token only ever lives in the cookie.
  refreshTokenHash String @unique
  familyId         String @db.Uuid

  deviceLabel String?
  ip          String?
  userAgent   String?

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Single-use, hashed, expiring tokens delivered by email.
model EmailToken {
  id     String @db.Uuid @id @default(uuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   EmailTokenPurpose
  tokenHash String            @unique

  /// Only set for EMAIL_CHANGE: the address being moved to.
  newEmail String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// A device's key material. The public key is the registry other users look up
/// to send this account a message; the two wrapped blobs are the same private
/// key sealed under two different secrets, and the server can open neither.
///
/// Storing them here is what lets someone sign in on a new machine: the blob
/// comes down with the login response and is unwrapped locally.
model Device {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human-readable, for the user's own device list. e.g. "Firefox on Windows".
  label String

  /// base64 X25519 public key. The only field here that is meant to be shared.
  publicKey String

  /// blob_A - the private key wrapped under the account password.
  wrappedPrivateKey String

  /// blob_B - the same private key wrapped under the recovery code.
  wrappedPrivateKeyRecovery String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  @@index([userId])
  @@index([publicKey])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for unauthenticated actions (a failed login, a reset request).
  actorUserId String? @db.Uuid
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  targetUserId String? @db.Uuid
  target       User?   @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action String
  ip     String?
  meta   Json?

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}
